# Development image: live-reload via air. The source tree is bind-mounted by
# the umbrella's docker-compose.dev.yml, so edits on the host trigger a rebuild.
FROM golang:1.26-alpine

RUN apk add --no-cache git tzdata && go install github.com/air-verse/air@latest

WORKDIR /app
EXPOSE 8080
CMD ["air", "-c", ".air.toml"]
