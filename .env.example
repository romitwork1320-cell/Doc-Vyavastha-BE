# ─── Application ───────────────────────────────────────────────────────────
APP_ENV=development          # development | production
HTTP_PORT=8080               # FE nginx proxies /api -> api:8080
LOG_LEVEL=debug              # debug | info | warn | error

# ─── Database (PostgreSQL) ─────────────────────────────────────────────────
# pgx connection string. The public schema holds platform data; each tenant
# gets its own schema (tenant_0001, ...) resolved at request time.
DATABASE_URL=postgres://edc:edc@localhost:5432/edconsultancy?sslmode=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=2

# ─── JWT / Auth ────────────────────────────────────────────────────────────
JWT_ISSUER=edconsultancy
JWT_ACCESS_SECRET=change-me-dev-only-please-rotate-in-prod-0123456789
JWT_ACCESS_TTL=15m           # short-lived access token
JWT_REFRESH_TTL=720h         # 30 days; stored hashed + delivered via httpOnly cookie
# temp token (issued before tenant selection in multi-tenant login)
JWT_TEMP_TTL=10m

# Refresh cookie attributes (the FE relies on withCredentials + httpOnly cookie)
COOKIE_NAME=edc_refresh
COOKIE_DOMAIN=               # empty = host-only
COOKIE_SECURE=false          # true in production (HTTPS)
COOKIE_SAMESITE=lax          # lax | strict | none  (none requires Secure=true)

# ─── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated. Must be explicit (not *) because credentials are sent.
CORS_ALLOWED_ORIGINS=http://localhost:4200
CLIENT_URL=http://localhost:4200

# ─── Google Login ──────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=111899420643-ismd8b48ech4lsdm76i2hedfe45f8qgv.apps.googleusercontent.com

# ─── Email (transactional: verification, OTP, set-password) ───────────────
# EMAIL_SENDER: log | smtp   (log just prints to stdout in dev)
EMAIL_SENDER=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@edconsultancy.local
EMAIL_FROM_NAME=EDConsultancy

# ─── OTP ───────────────────────────────────────────────────────────────────
OTP_TTL=5m
OTP_LENGTH=6

# ─── Public-link encryption (parity with FE EncryptionService) ─────────────
# AES-128-CBC/PKCS7, 16-byte IV prepended, URL-safe base64 (no padding).
LINK_ENCRYPTION_KEY=dreamworldi-9999
